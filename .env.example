# Copy to .env; unset values use docker-compose.yml defaults. Never set COMPOSE_* or DOCKER_* here.

# 30 mainnet, 31 testnet, anything else regtest.
RUSTOCK_NETWORK_ID=30
# Peers, tcp (rskj: 5050 mainnet, 50505 testnet).
RUSTOCK_P2P_PORT=5050
# Discovery, udp; must be the peer port + 1.
RUSTOCK_DISCOVERY_PORT=5051
# Public IPv4 address advertised to peers. Unset, networks 30 and 31 look it up;
# set it behind NAT or to skip the lookup.
RUSTOCK_EXTERNAL_IP=

# A named volume, or a host path (/ or ./) owned by uid 10001.
RUSTOCK_DATA_DIR=rustock-data

# trace, debug, info, warn, error, or per-module: info,rustock_sync=debug
RUSTOCK_LOG_LEVEL=info
# false writes rustock.log.<date> into the data directory instead.
RUSTOCK_LOG_TO_STDOUT=true
RUSTOCK_LOG_MAX_SIZE=50m
RUSTOCK_LOG_MAX_FILE=10

# The RPC has no authentication; do not bind it beyond a trusted network.
RUSTOCK_RPC_BIND=127.0.0.1
RUSTOCK_RPC_PORT=4444
RUSTOCK_METRICS_BIND=127.0.0.1
RUSTOCK_METRICS_PORT=9898

# Node binary to mount.
RUSTOCK_BINARY=./bin/rustock-cli
# Extra rustock-cli flags, e.g. "--snap-sync --rpc-admin".
RUSTOCK_EXTRA_ARGS=
